
{
  "issuers": [
    {
      "credential_issuer": "Mosip",
      "issuer_id": "Mosip",
      "credential_issuer_host": "https://injicertify.haiti-pilot.mosip.net",
      "wellknown_endpoint": "https://injicertify.haiti-pilot.mosip.net/v1/certify/issuance/.well-known/openid-credential-issuer",
      "display": [
        {
          "name": "Office National d'Identification",
          "logo": {
            "url": "https://haiti-pilot.github.io/inji-config/logo/ONI_logo.png",
            "alt_text": "oni-logo"
          },
          "title": "Office National d'Identification",
          "description": "Télécharger le document d'identification nationale",
          "language": "fr"
        }
      ],
      "protocol": "OpenId4VCI",
      "client_id": "${mimoto.oidc.partner.clientid}",
      "client_alias": "mpartner-default-mimotooidc",
      "scopes_supported": [
        "mosip_identity_vc_ldp"
      ],
      "additional_headers": {
        "Accept": "application/json"
      },
      ".well-known": "https://injicertify.haiti-pilot.mosip.net/v1/certify/issuance/.well-known/openid-credential-issuer",
      "redirect_uri": "io.mosip.residentapp.inji://oauthredirect",
      "authorization_endpoint": "https://${mosip.esignet.host}/authorize",
      "authorization_audience": "https://${mosip.esignet.host}/v1/esignet/oauth/v2/token",
      "token_endpoint": "https://${mosip.api.public.host}/residentmobileapp/get-token/Mosip",
      "proxy_token_endpoint": "https://${mosip.esignet.host}/v1/esignet/oauth/v2/token",
      "credential_endpoint": "https://injicertify.haiti-pilot.mosip.net/v1/certify/issuance/credential",
      "credential_type": [
        "VerifiableCredential",
        "MOSIPVerifiableCredential"
      ],
      "qr_code_type": "OnlineSharing",
      "credential_audience": "https://${mosip.esignet.host}",
      "enabled": "true"
    }
  ]
}
